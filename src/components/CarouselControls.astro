<div class="carousel-controls" aria-label="Carousel Navigation">
  <button 
    type="button" 
    class="control-btn prev-btn" 
    aria-label="Previous Slide"
    data-carousel-prev
  >
    <!-- Desktop arrow -->
    <svg width="42" height="22" viewBox="0 0 42 22" fill="none" class="arrow-svg desktop-arrow">
      <line x1="1" y1="11" x2="41" y2="11" stroke="#ffffff" stroke-width="1.2" />
      <polyline points="11 2 1 11 11 20" stroke="#ffffff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>

  <button 
    type="button" 
    class="control-btn next-btn" 
    aria-label="Next Slide"
    data-carousel-next
  >
    <!-- Desktop arrow -->
    <svg width="42" height="22" viewBox="0 0 42 22" fill="none" class="arrow-svg desktop-arrow">
      <line x1="1" y1="11" x2="41" y2="11" stroke="#ffffff" stroke-width="1.2" />
      <polyline points="31 2 41 11 31 20" stroke="#ffffff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
</div>

<style>
  .carousel-controls {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 20;
  }

  .control-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: auto;
    background: none;
    border: none;
    padding: 12px 6px;
    cursor: pointer;
    opacity: 0.75;
    transition: opacity 0.35s var(--ease-luxury), transform 0.35s var(--ease-luxury), color 0.35s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
  }

  .control-btn:hover {
    opacity: 1;
    color: var(--color-gold);
  }

  .prev-btn:hover .desktop-arrow {
    transform: translateX(-5px);
  }

  .next-btn:hover .desktop-arrow {
    transform: translateX(5px);
  }

  .desktop-arrow line,
  .desktop-arrow polyline {
    transition: stroke 0.3s ease;
  }

  .control-btn:hover .desktop-arrow line,
  .control-btn:hover .desktop-arrow polyline {
    stroke: var(--color-gold);
  }

  .control-btn:focus-visible {
    outline: 1px solid var(--color-gold);
    outline-offset: 4px;
  }

  .prev-btn {
    left: clamp(1.2rem, 3vw, 3.2rem);
  }

  .next-btn {
    right: clamp(1.2rem, 3vw, 3.2rem);
  }

  .desktop-arrow {
    display: block;
    width: clamp(34px, 3.2vw, 44px);
    height: auto;
    transition: transform 0.35s var(--ease-luxury);
  }

  /* Phone / Android: Glenn Spiro layout, arrows only (logo lives in header) */
  @media (max-width: 768px) {
    .carousel-controls {
      top: auto;
      bottom: max(5.5dvh, env(safe-area-inset-bottom, 24px));
      left: 0;
      right: 0;
      height: 48px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0 clamp(1.5rem, 6vw, 2.5rem);
      z-index: 30;
    }

    .desktop-arrow {
      width: 38px;
    }

    .control-btn {
      position: static;
      top: auto;
      transform: none;
      padding: 8px 10px;
      min-width: 44px;
      min-height: 44px;
      opacity: 0.85;
      pointer-events: auto;
      touch-action: manipulation;
      cursor: pointer;
    }

    .control-btn:hover {
      transform: none;
      opacity: 1;
    }

    .prev-btn {
      left: auto;
    }

    .next-btn {
      right: auto;
    }
  }
</style>
