---
import type { HeroSlideData } from '../data/heroSlides';

interface Props {
  slide: HeroSlideData;
  index: number;
  isActive: boolean;
}

const { slide, index, isActive } = Astro.props;
const hasContent = Boolean(slide.title);
const hasStatement = Boolean(slide.statement);
const isCritical = index === 0;
// Slide 0 has no -1280 variant and is preloaded by exact URL in BaseLayout
const srcset = isCritical ? undefined : `${slide.image.replace('.avif', '-1280.avif')} 1280w, ${slide.image} 2560w`;
---
<article 
  class={`hero-slide ${isActive ? 'is-active' : ''} ${hasContent ? 'is-product' : ''}`}
  data-slide-index={index}
  aria-hidden={!isActive}
>
  <div class="slide-artwork-wrapper">
    <img 
      src={isCritical ? slide.image : undefined}
      data-src={!isCritical ? slide.image : undefined}
      data-srcset={srcset}
      sizes="100vw"
      alt={slide.alt} 
      class="slide-artwork"
      loading={isCritical ? "eager" : "lazy"}
      fetchpriority={isCritical ? "high" : "low"}
      decoding={isCritical ? "sync" : "async"}
    />
  </div>

  {hasStatement && (
    <div class="slide-statement-container">
      <p class="slide-statement">{slide.statement}</p>
    </div>
  )}

  {hasContent && (
    <div class={`slide-content ${slide.position || 'lower-left'}`}>
      {slide.slug ? (
        <a href={`/the-edit/${slide.slug}`} class="product-link">
          <h2 class="product-title">{slide.title}</h2>
          {slide.description && <p class="product-desc">{slide.description}</p>}
        </a>
      ) : (
        <>
          <h2 class="product-title">{slide.title}</h2>
          {slide.description && <p class="product-desc">{slide.description}</p>}
        </>
      )}
    </div>
  )}
</article>

<style>
  .hero-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.85s var(--ease-luxury), visibility 0.85s var(--ease-luxury);
    pointer-events: none;
    overflow: hidden;
  }

  .hero-slide.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    z-index: 2;
  }

  .slide-artwork-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: hidden;
  }

  .slide-artwork {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    user-select: none;
    transform: scale(1.03);
    transition: transform 1.25s var(--ease-luxury);
  }

  .hero-slide.is-active .slide-artwork {
    transform: scale(1);
  }

  /* Centered brand statement (Slide 1) */
  .slide-statement-container {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 5;
    width: 90%;
    max-width: 780px;
    text-align: center;
    pointer-events: none;
  }

  .slide-statement {
    font-size: clamp(1.25rem, 2.2vw, 2.1rem);
    color: #ffffff;
    line-height: 1.55;
    letter-spacing: 0.02em;
    font-weight: 400;
    white-space: pre-line;
  }

  /* Product copy on jewellery slides */
  .slide-content {
    position: absolute;
    bottom: clamp(3.5rem, 8vh, 6.5rem);
    z-index: 5;
    pointer-events: auto;
    text-align: center;
  }

  .product-link {
    text-decoration: none;
    display: inline-block;
    cursor: pointer;
    pointer-events: auto;
  }

  .product-title {
    transition: color 0.3s ease, transform 0.3s ease;
  }

  .product-link:hover .product-title {
    color: var(--color-gold);
  }

  .slide-content.lower-left {
    left: clamp(3rem, 7vw, 7.5rem);
  }

  .slide-content.lower-right {
    right: clamp(3rem, 7vw, 7.5rem);
  }

  /* Mobile / Android: strict single viewport layout (Glenn Spiro match) */
  @media (max-width: 768px) {
    .slide-artwork-wrapper {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      height: 100dvh;
      overflow: hidden;
    }

    .slide-artwork {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 38%;
    }

    .hero-slide.is-active .slide-artwork {
      transform: none;
    }

    /* 16:9 art puts jewel in middle 56% of height; at 85dvh from 16dvh it sits
       between copy (ends ~32dvh) and arrows. Top band matches art's teal edge. */
    .hero-slide.is-product .slide-artwork-wrapper {
      background: #103236;
    }

    .hero-slide.is-product .slide-artwork,
    .hero-slide.is-product.is-active .slide-artwork {
      position: absolute;
      top: 16dvh;
      left: 50%;
      width: auto;
      height: 85dvh;
      max-width: none;
      object-fit: fill;
      transform: translateX(-50%);
      -webkit-mask-image: linear-gradient(to bottom, transparent, #000 10dvh);
      mask-image: linear-gradient(to bottom, transparent, #000 10dvh);
    }

    .slide-statement-container {
      top: 48%;
      width: 88%;
      max-width: 480px;
    }

    .slide-statement {
      font-size: clamp(1.05rem, 3.8vw, 1.35rem);
      line-height: 1.6;
    }

    .slide-content.lower-left,
    .slide-content.lower-right {
      left: 1.25rem;
      right: 1.25rem;
      top: 23dvh;
      bottom: auto;
      text-align: center;
      margin: 0 auto;
      /* Meher necklace wire can pass under copy on short screens */
      text-shadow: 0 1px 10px rgba(0, 0, 0, 0.55);
    }

    .product-title {
      font-size: clamp(1.15rem, 4.4vw, 1.38rem);
      letter-spacing: 0.12em;
      margin-bottom: 0.35rem;
      color: #ffffff;
      font-weight: 400;
      text-transform: uppercase;
      line-height: 1.3;
    }

    .product-desc {
      font-size: clamp(0.88rem, 3.4vw, 1.02rem);
      line-height: 1.45;
      letter-spacing: 0.02em;
      color: #cbb27a;
      white-space: pre-line;
      margin-top: 0.25rem;
    }
  }
</style>
