---
import logoSvg from '../../public/carpediam-logo-original.svg?raw';
// pathLength="1" normalizes every path so one dasharray value draws them all
const drawLogo = logoSvg
  .replace('<svg ', '<svg class="loader-logo" aria-hidden="true" ')
  .replaceAll('<path ', '<path pathLength="1" ');
---
<!-- Fast early check to prevent flash on internal navigation within the same session -->
<script is:inline>
  try {
    var isReload = false;
    var nav = performance.getEntriesByType('navigation')[0];
    if (nav && nav.type === 'reload') {
      isReload = true;
    }
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || (sessionStorage.getItem('cd_loader_seen') && !isReload)) {
      document.documentElement.classList.add('cd-skip-loader');
    }
  } catch (e) {}
</script>

<div class="loading-screen" id="site-loading-screen" aria-label="Carpe Diem" role="status">
  <Fragment set:html={drawLogo} />
  <div class="loader-line"><span></span></div>
  <span class="loader-label">Carpe Diem</span>
</div>

<style>
  :global(html.cd-skip-loader) #site-loading-screen {
    display: none !important;
  }

  .loading-screen {
    position: fixed;
    inset: 0;
    z-index: 99999;
    background: #173f3a;
    color: #e9e5dd;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transition: opacity 0.8s ease, visibility 0.8s ease;
    pointer-events: auto;
  }

  .loading-screen--done {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .loading-screen :global(.loader-logo) {
    width: 180px;
    height: auto;
    overflow: visible;
  }

  /* Outline traces in, then fill fades over it */
  .loading-screen :global(.loader-logo path) {
    fill: #e9e5dd;
    fill-opacity: 0;
    stroke: #e9e5dd;
    stroke-width: 0.6;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation:
      draw 1.5s cubic-bezier(0.65, 0, 0.35, 1) forwards,
      fill-in 0.6s ease 1.4s forwards;
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes fill-in {
    to {
      fill-opacity: 0.92;
      stroke-opacity: 0;
    }
  }

  .loader-line {
    width: 104px;
    height: 1px;
    background: rgba(233, 229, 221, 0.25);
    margin: 28px 0 13px;
    overflow: hidden;
  }

  .loader-line span {
    display: block;
    height: 100%;
    width: 100%;
    background: #e9e5dd;
    transform-origin: left;
    animation: load 2s ease forwards;
  }

  .loader-label {
    font-family: 'DM Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #8d8980;
  }

  @keyframes load {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .loading-screen {
      display: none !important;
    }
    .loader-line span {
      animation: none;
      transform: scaleX(1);
    }
  }
</style>

<script>
  function initLoadingScreen() {
    const loader = document.getElementById('site-loading-screen');
    if (!loader) return;

    // Inline head script already decided skip (reduced motion / seen this session)
    if (document.documentElement.classList.contains('cd-skip-loader')) return;

    try {
      sessionStorage.setItem('cd_loader_seen', 'true');
    } catch (e) {}

    // Logo draw + fill finishes at 2000ms, then transition away at 2200ms
    const dismissTimer = setTimeout(() => {
      loader.classList.add('loading-screen--done');
      setTimeout(() => {
        loader.style.display = 'none';
      }, 850);
    }, 2200);

    // Guaranteed safety timeout: never get stuck indefinitely
    setTimeout(() => {
      clearTimeout(dismissTimer);
      loader.classList.add('loading-screen--done');
      loader.style.display = 'none';
    }, 4000);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLoadingScreen);
  } else {
    initLoadingScreen();
  }
</script>
