---
import Logo from './Logo.astro';
import { navigationItems } from '../data/navigation';

interface Props {
  variant?: 'light' | 'dark';
  transparent?: boolean;
}

const { variant = 'light', transparent = false } = Astro.props;
---
<header class={`site-header ${variant} ${transparent ? 'always-transparent' : ''}`}>
  <div class="header-inner">
    <!-- Desktop Left Logo -->
    <div class="header-left desktop-only">
      <Logo variant={variant} />
    </div>

    <!-- Mobile Top Center Hamburger (Glenn Spiro reference) -->
    <div class="mobile-top-center mobile-only">
      <button 
        type="button" 
        class="mobile-menu-trigger" 
        aria-label="Open Navigation Menu"
        aria-expanded="false"
        data-menu-trigger
      >
        <span class="menu-line"></span>
        <span class="menu-line"></span>
        <span class="menu-line"></span>
      </button>
      <Logo variant={variant} class="mobile-header-logo" />
    </div>

    <!-- Desktop Right Navigation -->
    <nav class="header-right desktop-only" aria-label="Main Navigation">
      <ul class="nav-list">
        {navigationItems.map(item => (
          <li class="nav-item">
            <a href={item.href} class="nav-link">{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <!-- Fullscreen Luxury Mobile Menu Overlay -->
  <div class="mobile-menu-overlay" id="mobile-menu-overlay" aria-hidden="true">
    <div class="mobile-menu-header">
      <button 
        type="button" 
        class="mobile-menu-close" 
        aria-label="Close Menu"
        data-menu-close
      >
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>

    <nav class="mobile-nav-body">
      <a href="/" class="mobile-brand-link" aria-label="Go to Home Screen">
        <span class="mobile-menu-eyebrow">Carpe Diam Bombay</span>
      </a>

      <ul class="mobile-nav-list">
        <li>
          <a href="/" class="mobile-nav-link">Home</a>
        </li>
        {navigationItems.map(item => (
          <li>
            <a href={item.href} class="mobile-nav-link">{item.label}</a>
          </li>
        ))}
      </ul>

      <p class="mobile-menu-footer-note">High Jewellery Atelier · Bombay</p>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 50;
    pointer-events: none;
    padding: clamp(1.25rem, 3.5vh, 2.5rem) var(--spacing-header-x);
    box-sizing: border-box;
    transition: padding 0.4s var(--ease-luxury), background-color 0.4s var(--ease-luxury), border-color 0.4s var(--ease-luxury), backdrop-filter 0.4s var(--ease-luxury);
    border-bottom: 1px solid transparent;
  }

  .site-header.is-scrolled {
    padding: clamp(0.85rem, 2vh, 1.25rem) var(--spacing-header-x);
    background-color: rgba(6, 17, 15, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(197, 168, 108, 0.18);
  }

  .site-header.always-transparent,
  .site-header.always-transparent.is-scrolled {
    background-color: transparent !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    border-bottom: 1px solid transparent !important;
  }

  .header-inner {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    pointer-events: auto;
  }

  .desktop-only {
    display: flex;
  }

  .mobile-only {
    display: none;
  }

  .header-left {
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }

  .header-right {
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }

  .nav-list {
    display: flex;
    list-style: none;
    gap: clamp(1.5rem, 3.2vw, 3.5rem);
    margin: 0;
    padding: 0;
    align-items: center;
    flex-wrap: nowrap;
  }

  .nav-item {
    white-space: nowrap;
    flex-shrink: 0;
  }

  .nav-link {
    font-family: var(--font-primary);
    font-size: clamp(0.95rem, 1.1vw, 1.15rem);
    font-weight: 400;
    letter-spacing: 0.08em;
    color: #f7f4ed;
    text-decoration: none;
    transition: color 0.3s var(--ease-luxury);
    cursor: pointer;
    display: inline-block;
    padding: 0.3rem 0;
    position: relative;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: var(--color-gold);
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 0.35s var(--ease-luxury);
  }

  .nav-link:hover {
    color: var(--color-gold);
  }

  .nav-link:hover::after {
    transform: scaleX(1);
    transform-origin: left center;
  }

  .site-header.dark .nav-link {
    color: #1a1a1a;
  }

  .site-header.dark .nav-link:hover {
    color: var(--color-gold);
  }

  /* Mobile / Android: Glenn Spiro reference layout */
  @media (max-width: 768px) {
    .desktop-only {
      display: none !important;
    }

    .mobile-only {
      display: flex !important;
    }

    .site-header {
      padding: max(6dvh, env(safe-area-inset-top)) 1.5rem 0.5rem;
    }

    .header-inner {
      justify-content: center;
    }

    .mobile-top-center {
      position: relative;
      width: 100%;
      display: flex;
      justify-content: center;
      align-items: center;
      pointer-events: auto;
      min-height: 44px;
    }

    /* Hamburger pinned left vertically aligned with logo center */
    .mobile-menu-trigger {
      position: absolute;
      left: 0;
      top: 50%;
      transform: translateY(-50%);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
      gap: 5px;
      width: 44px;
      height: 44px;
      padding: 0;
      background: transparent;
      border: none;
      cursor: pointer;
      pointer-events: auto;
      z-index: 60;
      touch-action: manipulation;
    }

    .mobile-top-center :global(.mobile-header-logo .logo-svg) {
      width: clamp(140px, 40vw, 170px);
    }

    .menu-line {
      display: block;
      width: 24px;
      height: 1.3px;
      border-radius: 1px;
      background-color: #ffffff;
      transition: transform 0.3s ease, opacity 0.3s ease, background-color 0.3s ease;
      pointer-events: none;
      filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.45));
    }

    /* On light / parchment transparent headers, ensure dark visible lines */
    .site-header.always-transparent .menu-line,
    .site-header.dark .menu-line {
      background-color: #141414;
      filter: drop-shadow(0 1px 1px rgba(255, 255, 255, 0.5));
    }
  }

  /* Fullscreen mobile overlay */
  .mobile-menu-overlay {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    background-color: rgba(6, 17, 15, 0.98);
    backdrop-filter: blur(16px);
    z-index: 9999;
    display: flex;
    flex-direction: column;
    padding: max(1.2rem, env(safe-area-inset-top)) 1.5rem max(2rem, env(safe-area-inset-bottom));
    box-sizing: border-box;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.35s ease, visibility 0.35s ease;
  }

  .mobile-menu-overlay.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .mobile-menu-header {
    display: flex;
    justify-content: flex-end;
    width: 100%;
  }

  .mobile-menu-close {
    background: transparent;
    border: none;
    color: #cbb27a;
    padding: 0.8rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    touch-action: manipulation;
    pointer-events: auto;
  }

  .mobile-nav-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 2.2rem;
    pointer-events: auto;
  }

  .mobile-brand-link {
    text-decoration: none;
    display: inline-block;
    padding: 0.5rem;
    cursor: pointer;
  }

  .mobile-menu-eyebrow {
    font-size: 0.85rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #cbb27a;
    transition: opacity 0.3s ease;
  }

  .mobile-brand-link:hover .mobile-menu-eyebrow {
    opacity: 0.8;
  }

  .mobile-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
    align-items: center;
  }

  .mobile-nav-link {
    font-size: 1.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #ffffff;
    text-decoration: none;
    transition: color 0.3s ease;
    display: inline-block;
    padding: 0.5rem 1.5rem;
    touch-action: manipulation;
    cursor: pointer;
  }

  .mobile-nav-link:hover {
    color: #cbb27a;
  }

  .mobile-menu-footer-note {
    font-size: 0.85rem;
    color: rgba(203, 178, 122, 0.7);
    letter-spacing: 0.08em;
  }
</style>

<script>
  function setupMobileMenu() {
    const trigger = document.querySelector('[data-menu-trigger]') as HTMLElement | null;
    const closeBtn = document.querySelector('[data-menu-close]');
    const overlay = document.getElementById('mobile-menu-overlay');

    if (!trigger || !overlay || trigger.dataset.bound) return;
    trigger.dataset.bound = 'true';

    function openMenu(e) {
      if (e) e.stopPropagation();
      overlay.classList.add('is-active');
      overlay.setAttribute('aria-hidden', 'false');
      trigger.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      (closeBtn as HTMLElement | null)?.focus();
    }

    function closeMenu(e) {
      if (e) e.stopPropagation();
      overlay.classList.remove('is-active');
      overlay.setAttribute('aria-hidden', 'true');
      trigger.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      trigger.focus();
    }

    trigger.addEventListener('click', openMenu);
    closeBtn?.addEventListener('click', closeMenu);

    window.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape' && overlay.classList.contains('is-active')) {
        closeMenu(e);
      }
    });

    // Let navigation links navigate immediately without preventDefault, closing overlay
    overlay.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        overlay.classList.remove('is-active');
        overlay.setAttribute('aria-hidden', 'true');
        trigger.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupMobileMenu);
  } else {
    setupMobileMenu();
  }
</script>
