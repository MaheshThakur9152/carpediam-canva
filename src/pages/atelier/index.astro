---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Atelier — CARPE DIAM BOMBAY"
  showFooter={false}
  headerVariant="light"
  headerTransparent={true}
>
  <div class="atelier-page">
    <!-- Section 1: full-bleed craftsman image with centered statement -->
    <section class="atelier-hero">
      <img
        src="/atlier.jpg"
        alt="Carpe Diam Atelier Craftsmanship"
        class="atelier-hero-img"
        loading="eager"
        decoding="async"
      />
      <h1 class="atelier-heading">
        Carpe Diam was born from a shared perspective on design, craftsmanship, and contemporary fine jewelry.
      </h1>
    </section>

    <!-- Section 2: founders copy with necklace -->
    <section class="atelier-story">
      <div class="atelier-copy">
        <p class="atelier-eyebrow">Jewelry, with a point of view.</p>
        <p class="atelier-body">
          Founded by <strong>Joohi and Rushabh</strong>, Carpe Diam brings together artistic vision and international jewelry expertise to create pieces that balance contemporary design with Indian sensibilities, thoughtful in form and precise in craftsmanship.
        </p>
      </div>
      <!-- Necklace image: public/atelier-necklace.avif -->
      <img
        src="/atelier-necklace.avif"
        alt="Carpe Diam diamond and pearl choker"
        class="atelier-necklace"
        loading="lazy"
        decoding="async"
      />
    </section>
  </div>
</BaseLayout>

<style>
  .atelier-page {
    width: 100%;
  }

  /* Section 1 */
  .atelier-hero {
    position: relative;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    background-color: #111111;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .atelier-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 62%;
  }

  .atelier-heading {
    position: relative;
    max-width: 26ch;
    margin: 0;
    padding: 0 1.5rem;
    text-align: center;
    font-family: var(--font-primary, "Amiri", serif);
    font-weight: 400;
    font-size: clamp(1.85rem, 2.7vw, 2.9rem);
    line-height: 1.32;
    letter-spacing: 0.01em;
    color: #ffffff;
    text-transform: none;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.35);
  }

  /* Section 2: copy left, necklace box flush to the right edge (Figma "Atelier 2") */
  .atelier-story {
    height: 100vh;
    height: 100dvh;
    min-height: 560px;
    background-color: #d9d3bf;
    display: grid;
    grid-template-columns: 45fr 55fr;
    grid-template-rows: minmax(0, 1fr);
    align-items: center;
    padding-left: clamp(2rem, 10vw, 10rem);
    box-sizing: border-box;
    overflow: hidden;
  }

  .atelier-copy {
    max-width: 25rem;
    padding-right: clamp(1.5rem, 3vw, 3rem);
  }

  .atelier-eyebrow {
    font-family: var(--font-primary, "Amiri", serif);
    font-style: italic;
    font-size: clamp(1.2rem, 1.45vw, 1.55rem);
    letter-spacing: 0.02em;
    color: #1a1a1a;
    margin: 0 0 clamp(1rem, 2vh, 1.4rem);
  }

  .atelier-body {
    font-family: var(--font-primary, "Amiri", serif);
    font-size: clamp(1.2rem, 1.45vw, 1.55rem);
    line-height: 1.45;
    letter-spacing: 0.01em;
    color: #1a1a1a;
    margin: 0;
  }

  .atelier-body strong {
    font-weight: 700;
  }

  /* Source is 1080x1920 with the choker in the middle band: crop to it and let the right side bleed */
  .atelier-necklace {
    width: 100%;
    height: 76%;
    object-fit: cover;
    object-position: 0 52%;
    transform: scale(1.12);
    transform-origin: left center;
  }

  @media (max-width: 900px) {
    .atelier-story {
      height: auto;
      min-height: 100dvh;
      grid-template-columns: 1fr;
      grid-template-rows: auto auto;
      align-content: center;
      gap: 2rem;
      padding: 6rem 0 3rem 1.5rem;
    }

    .atelier-copy {
      padding-right: 1.5rem;
    }

    .atelier-body {
      font-size: 1.1rem;
    }

    .atelier-necklace {
      height: auto;
      aspect-ratio: 4 / 3;
    }
  }
</style>
