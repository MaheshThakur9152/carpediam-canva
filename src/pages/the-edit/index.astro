---
import BaseLayout from '../../layouts/BaseLayout.astro';

const gridItems = [
  {
    title: 'Emerald Fan Drop Earrings',
    image: '/the edit/earing.avif',
    alt: 'Handcrafted emerald and diamond fan drop earrings in gold'
  },
  {
    title: 'Carpe Diam Signet Ring',
    image: '/the edit/ring.avif',
    alt: 'Gold signet ring with engraved Carpe Diam crest on vintage parchment'
  },
  {
    title: 'Diamond Double Strand Necklace',
    image: '/the edit/necklace.avif',
    alt: 'Double strand diamond choker necklace with floral motifs'
  },
  {
    title: 'Polki Pearl Stud Earrings',
    image: '/the edit/polki.avif',
    alt: 'Floral uncut polki diamond and pearl earrings'
  },
  {
    title: 'Coiled Pear Diamond Ring',
    image: '/the edit/ring2.avif',
    alt: 'Coiled multi-band ring with pear diamond worn on hand'
  },
  {
    title: 'Emerald Cabochon Tennis Bracelet',
    image: '/the edit/bracelet.avif',
    alt: 'Alternating emerald cabochon and baguette diamond gold bracelet'
  },
  {
    title: 'Floral Enamel Chain Bracelet',
    image: '/the edit/necklace2.avif',
    alt: 'Artisan gold chain bracelet with turquoise and emerald floral stations'
  },
  {
    title: 'Heritage Polki Floral Studs',
    image: '/the edit/polki-green.avif',
    alt: 'Polki and pearl floral earrings on antique woven textile'
  },
  {
    title: 'Emerald & Tanzanite Halo Ring',
    image: '/the edit/ring3.avif',
    alt: 'Emerald cabochon ring encircled with royal blue tanzanite halo in yellow gold'
  }
];
---

<BaseLayout 
  title="The Edit — CARPE DIAM BOMBAY"
  description="Objects with a point of view. Discover the curated high jewellery collection by Carpe Diam Bombay."
  headerVariant="light"
  headerTransparent={true}
  showFooter={false}
>
  <div class="the-edit-page">
    <div class="the-edit-container">
      <h1 class="visually-hidden">The Edit — Objects with a point of view</h1>
      <div class="the-edit-grid" id="the-edit-grid">
        {gridItems.map((item, index) => (
          <div class="the-edit-card" data-index={index}>
            <div class="the-edit-card-inner">
              <img 
                src={item.image} 
                alt={item.alt} 
                class="the-edit-img" 
                loading={index < 3 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .the-edit-page {
    min-height: 100vh;
    width: 100%;
    background-image: url('/the%20edit/background.avif');
    background-size: cover;
    background-position: center top;
    background-repeat: no-repeat;
    background-attachment: fixed;
    padding: clamp(6.5rem, 13vh, 8.5rem) clamp(1.5rem, 4vw, 3.5rem) clamp(4rem, 8vh, 6rem);
    box-sizing: border-box;
    font-family: var(--font-primary, "Amiri", serif);
  }

  .the-edit-container {
    max-width: 1120px;
    margin: 0 auto;
    width: 100%;
  }

  .the-edit-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.25rem, 2.5vw, 2.5rem);
    width: 100%;
  }

  .the-edit-card {
    position: relative;
    aspect-ratio: 1 / 1;
    width: 100%;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    transition: transform 0.4s var(--ease-luxury, cubic-bezier(0.25, 1, 0.5, 1)), box-shadow 0.4s ease;
  }

  .the-edit-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.12);
  }

  .the-edit-card-inner {
    width: 100%;
    height: 100%;
    background-color: #ffffff;
    overflow: hidden;
  }

  .the-edit-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.6s var(--ease-luxury, cubic-bezier(0.25, 1, 0.5, 1));
  }

  .the-edit-card:hover .the-edit-img {
    transform: scale(1.03);
  }

  @media (max-width: 860px) {
    .the-edit-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }

  @media (max-width: 520px) {
    .the-edit-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .the-edit-page {
      padding-top: 5.5rem;
    }
  }
</style>
