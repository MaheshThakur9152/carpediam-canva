---
import BaseLayout from '../../layouts/BaseLayout.astro';

const gridItems = [
  {
    title: 'Emerald Fan Drop Earrings',
    image: '/the edit/earing.avif',
    alt: 'Handcrafted emerald and diamond fan drop earrings in gold'
  },
  {
    title: 'Carpe Diam Signet Ring',
    image: '/the edit/ring.avif',
    alt: 'Gold signet ring with engraved Carpe Diam crest on vintage parchment'
  },
  {
    title: 'Diamond Double Strand Necklace',
    image: '/the edit/necklace.avif',
    alt: 'Double strand diamond choker necklace with floral motifs'
  },
  {
    title: 'Polki Pearl Stud Earrings',
    image: '/the edit/polki.avif',
    alt: 'Floral uncut polki diamond and pearl earrings'
  },
  {
    title: 'Coiled Pear Diamond Ring',
    image: '/the edit/ring2.avif',
    alt: 'Coiled multi-band ring with pear diamond worn on hand'
  },
  {
    title: 'Emerald Cabochon Tennis Bracelet',
    image: '/the edit/bracelet.avif',
    alt: 'Alternating emerald cabochon and baguette diamond gold bracelet'
  },
  {
    title: 'Floral Enamel Chain Bracelet',
    image: '/the edit/necklace2.avif',
    alt: 'Artisan gold chain bracelet with turquoise and emerald floral stations'
  },
  {
    title: 'Heritage Polki Floral Studs',
    image: '/the edit/polki-green.avif',
    alt: 'Polki and pearl floral earrings on antique woven textile'
  },
  {
    title: 'Emerald & Tanzanite Halo Ring',
    image: '/the edit/ring3.avif',
    alt: 'Emerald cabochon ring encircled with royal blue tanzanite halo in yellow gold'
  }
];
---

<BaseLayout 
  title="The Edit — CARPE DIAM BOMBAY"
  description="Objects with a point of view. Discover the curated high jewellery collection by Carpe Diam Bombay."
  headerVariant="light"
  headerTransparent={true}
  showFooter={false}
>
  <div class="the-edit-page">
    <div class="the-edit-container">
      <h1 class="visually-hidden">The Edit — Objects with a point of view</h1>
      <div class="the-edit-grid" id="the-edit-grid">
        {gridItems.map((item, index) => (
          <div class="the-edit-card" data-index={index}>
            <div class="the-edit-card-inner">
              <img 
                src={item.image} 
                alt={item.alt} 
                class="the-edit-img" 
                loading={index < 3 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Desktop: endless, slow auto-glide of the row. Wheel/trackpad push it along with eased momentum,
  // hover eases it to a stop. Phones keep the vertical grid untouched; reduced motion gets a plain scroll row.
  const grid = document.getElementById('the-edit-grid');
  const desktop = window.matchMedia('(min-width: 861px)');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const BASE_SPEED = 38; // px per second
  let x = 0;
  let speed = 0;
  let push = 0;
  let hovering = false;
  let loopWidth = 0;
  let frame = 0;
  let last = 0;

  const measure = () => {
    const firstClone = grid?.querySelector<HTMLElement>('.is-clone');
    const first = grid?.firstElementChild as HTMLElement | null;
    loopWidth = firstClone && first ? firstClone.offsetLeft - first.offsetLeft : 0;
  };

  const tick = (now: number) => {
    if (!grid) return;
    const dt = Math.min((now - last) / 1000, 0.05);
    last = now;
    speed += ((hovering ? 0 : BASE_SPEED) - speed) * Math.min(dt * 3, 1);
    const step = push * Math.min(dt * 6, 1);
    push -= step;
    x += speed * dt + step;
    if (loopWidth > 0) x = ((x % loopWidth) + loopWidth) % loopWidth;
    grid.style.transform = `translate3d(${-x}px, 0, 0)`;
    frame = requestAnimationFrame(tick);
  };

  const onWheel = (e: WheelEvent) => {
    e.preventDefault();
    // deltaMode 1 = lines (Firefox mouse wheels)
    const delta = (Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY) * (e.deltaMode === 1 ? 40 : 1);
    push += delta;
  };

  const enter = () => { hovering = true; };
  const leave = () => { hovering = false; };

  const start = () => {
    if (!grid || frame) return;
    // Second copy of the cards makes the loop seamless; hidden from assistive tech
    Array.from(grid.children).forEach((card) => {
      const clone = card.cloneNode(true) as HTMLElement;
      clone.classList.add('is-clone');
      clone.setAttribute('aria-hidden', 'true');
      clone.querySelector('img')?.setAttribute('alt', '');
      grid.appendChild(clone);
    });
    grid.classList.add('is-gliding');
    measure();
    grid.addEventListener('wheel', onWheel, { passive: false });
    grid.addEventListener('mouseenter', enter);
    grid.addEventListener('mouseleave', leave);
    window.addEventListener('resize', measure);
    last = performance.now();
    frame = requestAnimationFrame(tick);
  };

  const stop = () => {
    if (!grid || !frame) return;
    cancelAnimationFrame(frame);
    frame = 0;
    grid.querySelectorAll('.is-clone').forEach((el) => el.remove());
    grid.classList.remove('is-gliding');
    grid.style.transform = '';
    grid.removeEventListener('wheel', onWheel);
    grid.removeEventListener('mouseenter', enter);
    grid.removeEventListener('mouseleave', leave);
    window.removeEventListener('resize', measure);
    x = speed = push = 0;
  };

  const sync = () => (desktop.matches && !reduceMotion.matches ? start() : stop());
  desktop.addEventListener('change', sync);
  reduceMotion.addEventListener('change', sync);
  sync();
</script>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .the-edit-page {
    min-height: 100vh;
    width: 100%;
    background-image: url('/the%20edit/background.avif');
    background-size: cover;
    background-position: center top;
    background-repeat: no-repeat;
    background-attachment: fixed;
    padding: clamp(6.5rem, 13vh, 8.5rem) clamp(1.5rem, 4vw, 3.5rem) clamp(4rem, 8vh, 6rem);
    box-sizing: border-box;
    font-family: var(--font-primary, "Amiri", serif);
  }

  .the-edit-container {
    max-width: 1120px;
    margin: 0 auto;
    width: 100%;
  }

  .the-edit-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.25rem, 2.5vw, 2.5rem);
    width: 100%;
  }

  .the-edit-card {
    position: relative;
    aspect-ratio: 1 / 1;
    width: 100%;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    transition: transform 0.4s var(--ease-luxury, cubic-bezier(0.25, 1, 0.5, 1)), box-shadow 0.4s ease;
  }

  .the-edit-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.12);
  }

  .the-edit-card-inner {
    width: 100%;
    height: 100%;
    background-color: #ffffff;
    overflow: hidden;
  }

  .the-edit-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.6s var(--ease-luxury, cubic-bezier(0.25, 1, 0.5, 1));
  }

  .the-edit-card:hover .the-edit-img {
    transform: scale(1.03);
  }

  /* Desktop: single horizontal row of portrait cards (Figma "The Edit") */
  @media (min-width: 861px) {
    .the-edit-page {
      height: 100vh;
      height: 100dvh;
      padding: max(6rem, 22vh) 0 max(3rem, 16vh);
      display: flex;
      align-items: center;
      overflow: hidden;
    }

    .the-edit-container {
      max-width: none;
      height: 100%;
    }

    .the-edit-grid {
      display: flex;
      gap: clamp(0.75rem, 1.2vw, 1.25rem);
      height: 100%;
      padding: 0 var(--spacing-header-x);
      overflow-x: auto;
      overflow-y: hidden;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      box-sizing: border-box;
    }

    .the-edit-grid::-webkit-scrollbar {
      display: none;
    }

    /* Auto-glide: JS moves the row with a transform, so the container clips instead of scrolling */
    .the-edit-container:has(.is-gliding) {
      overflow: hidden;
      /* Cards dissolve into the edges instead of hard-cutting */
      -webkit-mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent);
      mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent);
    }

    .the-edit-grid.is-gliding {
      overflow: visible;
      width: max-content;
      will-change: transform;
    }

    .the-edit-card {
      flex: 0 0 auto;
      height: 100%;
      width: auto;
      aspect-ratio: 3 / 4;
      box-shadow: none;
    }

    .the-edit-card:hover {
      transform: none;
      box-shadow: none;
    }
  }

  @media (max-width: 860px) {
    .the-edit-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }

  @media (max-width: 520px) {
    .the-edit-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .the-edit-page {
      padding-top: 5.5rem;
    }
  }
</style>
