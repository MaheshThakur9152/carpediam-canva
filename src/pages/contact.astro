---
import BaseLayout from '../layouts/BaseLayout.astro';

// TODO: replace with the studio's WhatsApp number (country code, digits only)
const WHATSAPP_NUMBER = '910000000000';
const wa = (text: string) => `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(text)}`;
---

<BaseLayout
  title="Contact — CARPE DIAM BOMBAY"
  description="Visit the Carpe Diam studio in Andheri East, Mumbai. Book an appointment or chat with us."
  headerVariant="light"
  headerTransparent={true}
  showFooter={false}
>
  <div class="contact-page">
    <section class="contact-info">
      <h1 class="contact-city">Mumbai</h1>
      <address class="contact-address">
        506, 93 East Building, Mahakali Caves Rd,<br />
        Shanti Nagar, Andheri East, Mumbai,<br />
        Maharashtra 400093
      </address>

      <ul class="contact-actions">
        <li>
          <a class="contact-action" href={wa("Hello, I'd like to book an appointment.")} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3.5" y="5" width="17" height="15.5" rx="3" />
              <path d="M3.5 10h17M8 3v4M16 3v4" />
            </svg>
            Book an appointment
          </a>
        </li>
        <li>
          <a class="contact-action" id="chat-link" href={wa('Hello, ')} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4.5 19.5l1.1-3.6A8.3 8.3 0 1 1 8.4 18.5z" />
              <path d="M9.2 8.4c-.3 1.9 2.1 5 4.6 5.8.7.2 1.4-.2 1.7-.8l.2-.5-1.6-.9-.7.7c-.9-.3-2-1.4-2.4-2.3l.7-.7-.8-1.6-.6.1c-.6.1-1 .5-1.1 1.2z" />
            </svg>
            Chat with us
          </a>
        </li>
      </ul>
    </section>

    <img
      src="/contact.avif"
      alt="Carpe Diam studio: a necklace on a bust beside a jewelry tray"
      class="contact-photo"
      loading="eager"
      decoding="async"
    />
  </div>
</BaseLayout>

<script>
  // Product pages link here with ?inquiry=<slug>; carry it into the WhatsApp message
  const inquiry = new URLSearchParams(location.search).get('inquiry');
  const chat = document.getElementById('chat-link') as HTMLAnchorElement | null;
  if (inquiry && chat) {
    const url = new URL(chat.href);
    url.searchParams.set('text', `Hello, I'd like to know more about ${inquiry.replace(/-/g, ' ')}.`);
    chat.href = url.toString();
  }
</script>

<style>
  .contact-page {
    width: 100%;
    height: 100vh;
    height: 100dvh;
    min-height: 560px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    /* Without this the row grows to the portrait photo's natural height and the page scrolls */
    grid-template-rows: minmax(0, 1fr);
    overflow: hidden;
    font-family: var(--font-primary, "Amiri", serif);
    color: #ffffff;
  }

  .contact-info {
    background: #0a1917;
    padding: clamp(7rem, 31vh, 16rem) clamp(2rem, 5.2vw, 5.5rem) 0;
    box-sizing: border-box;
  }

  .contact-city {
    font-family: inherit;
    font-weight: 400;
    font-size: clamp(1.6rem, 2.3vw, 2.6rem);
    line-height: 1.1;
    letter-spacing: 0.01em;
    text-transform: none;
    color: inherit;
    margin: 0 0 0.35rem;
  }

  .contact-address {
    font-style: normal;
    font-size: clamp(1rem, 1.45vw, 1.6rem);
    line-height: 1.35;
    color: rgba(255, 255, 255, 0.9);
    margin: 0 0 clamp(2.5rem, 9vh, 5.5rem);
  }

  .contact-actions {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(0.4rem, 1.2vh, 0.8rem);
  }

  .contact-action {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    font-size: 24px;
    color: inherit;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .contact-action svg {
    width: 25px;
    height: 25px;
    flex-shrink: 0;
  }

  .contact-action:hover {
    opacity: 0.75;
  }

  .contact-photo {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  @media (max-width: 900px) {
    /* One screen, no scroll: teal info sized to its copy, photo fills the rest */
    .contact-page {
      grid-template-columns: 1fr;
      grid-template-rows: auto minmax(0, 1fr);
      overflow: hidden;
    }

    .contact-info {
      min-height: 0;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: clamp(7.25rem, 17dvh, 10rem) 1.5rem 2rem;
    }

    .contact-city {
      font-size: 2.4rem;
      margin-bottom: 0.6rem;
    }

    .contact-address {
      font-size: 1.05rem;
      line-height: 1.55;
      margin-bottom: 1.75rem;
    }

    .contact-actions {
      gap: 0;
      border-top: 1px solid rgba(255, 255, 255, 0.35);
    }

    .contact-actions li {
      border-bottom: 1px solid rgba(255, 255, 255, 0.35);
    }

    .contact-action {
      display: flex;
      width: 100%;
      padding: 0.9rem 0;
      font-size: 1.25rem;
    }

    /* Keep the bust and necklace in frame when the photo gets short */
    .contact-photo {
      min-height: 0;
      object-position: 35% 62%;
    }

    /* Transparent headers force dark menu lines; they vanish on the teal panel */
    :global(.site-header.always-transparent .menu-line) {
      background-color: #ffffff !important;
      filter: none !important;
    }
  }

  /* Short phones (most Android screens with browser bars): tighter type so the photo keeps room */
  @media (max-width: 900px) and (max-height: 740px) {
    .contact-info {
      padding: 7.5rem 1.5rem 1.5rem;
    }

    .contact-city {
      font-size: 2rem;
      margin-bottom: 0.4rem;
    }

    .contact-address {
      font-size: 0.98rem;
      line-height: 1.45;
      margin-bottom: 1.25rem;
    }

    .contact-action {
      padding: 0.75rem 0;
      font-size: 1.15rem;
    }
  }
</style>
