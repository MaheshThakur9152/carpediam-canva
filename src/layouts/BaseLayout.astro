---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Preloader from '../components/Preloader.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  headerVariant?: 'light' | 'dark';
  headerTransparent?: boolean;
  showFooter?: boolean;
  isHome?: boolean;
  isSinglePage?: boolean;
}

const {
  title = 'CARPE DIAM BOMBAY — High Jewellery Atelier',
  description = 'Carpe Diam Bombay. Exceptional handcrafted high jewellery, uncut polki diamonds, carved gemstones and bespoke heirlooms in 14kt gold.',
  headerVariant = 'light',
  headerTransparent = false,
  showFooter = true,
  isHome = false,
  isSinglePage = false
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en" class={isHome || isSinglePage ? 'is-home-page' : ''}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/carpediam-logo.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Critical Assets Preload -->
    <link 
      rel="preload" 
      href="/fonts/amiri-latin-400-normal.woff2" 
      as="font" 
      type="font/woff2" 
      crossorigin 
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400;1,700&family=DM+Mono:wght@300;400&display=swap" rel="stylesheet" />
    {isHome && (
      <>
        <link 
          rel="preload" 
          href="/Homepage-1.avif" 
          as="image" 
          type="image/avif" 
          fetchpriority="high" 
        />
      </>
    )}
  </head>
  <body class={isHome || isSinglePage ? 'is-home-page' : ''}>
    <Preloader />
    {!isHome && !isSinglePage && <div class="scroll-progress-line" aria-hidden="true" />}
    <Header variant={headerVariant} transparent={headerTransparent} />
    <main class={isHome || isSinglePage ? 'is-home-main' : ''}>
      <slot />
    </main>
    {showFooter && !isSinglePage && <Footer />}

    <script src="../components/animations/index.ts"></script>
  </body>
</html>

<style>
  main {
    min-height: 100vh;
  }

  :global(html.is-home-page),
  :global(body.is-home-page) {
    height: 100vh;
    height: 100dvh;
    max-height: 100dvh;
    overflow: hidden !important;
    position: fixed;
    inset: 0;
    width: 100vw;
    margin: 0;
    padding: 0;
    overscroll-behavior: none;
    touch-action: pan-x;
  }

  :global(.is-home-main) {
    height: 100vh;
    height: 100dvh;
    max-height: 100dvh;
    min-height: 0 !important;
    width: 100vw;
    overflow: hidden !important;
    position: relative;
  }
</style>
